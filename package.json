{
  "name": "tartaruguinha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Webcam posture coach: nudges you when you slouch.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:icons": "~/.venv/bin/python scripts/gen_icons.py",
    "fetch:pose": "node scripts/fetch_pose_assets.mjs",
    "setup": "npm install && node scripts/fetch_pose_assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0"
  }
}

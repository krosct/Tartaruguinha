# Tartaruguinha environment template.
# Copy this file to `.env` (cp env.example .env) and edit.
# Never commit the real `.env`. The `.env` file is git-ignored.
# VITE_* values are exposed to the browser. They are the defaults; the
# "Configurações" panel on the site can override them per browser.
# Restart `npm run dev` after editing this file.

FRONTEND_PORT=5173

# --- Display ---------------------------------------------------------------
# Show the reference frame (colored square) and the detected skeleton.
VITE_SHOW_GUIDE=true
VITE_SHOW_SKELETON=true

# --- Posture rule ----------------------------------------------------------
# Neck height / shoulder width below this = hunched. Higher = stricter.
VITE_HUNCHED_NECK_RATIO=0.6
# Nose or a shoulder below this visibility = torso not visible.
VITE_MIN_LANDMARK_VISIBILITY=0.5
# Mean visibility of nose + shoulders below this = unsure.
VITE_CONFIDENCE_THRESHOLD=0.6

# --- Timing and stability --------------------------------------------------
# How often MediaPipe analyzes the video, in ms.
VITE_DETECT_INTERVAL_MS=100
# How often a reading feeds the stabilizer and alerts, in ms.
VITE_VERDICT_INTERVAL_MS=500
# Consecutive identical readings before the shown state changes.
VITE_STATE_SMOOTHING=2

# --- Alert -----------------------------------------------------------------
# Minimum gap between sound alerts (chime + screen flash), in ms.
VITE_ALERT_COOLDOWN_MS=60000
# Minimum gap between system notifications, in ms. Independent of the sound.
VITE_NOTIFICATION_COOLDOWN_MS=60000
# on | off
VITE_ALERT_SOUND=on
# 0 (mute) to 1 (max).
VITE_ALERT_VOLUME=0.6

# --- Background ------------------------------------------------------------
# What happens when the tab is hidden:
# off (pause) | worker (keep analyzing) | pip (floating window, Chrome/Edge desktop)
VITE_BACKGROUND_MODE=worker

# --- Detector (MediaPipe) --------------------------------------------------
# lite | full | heavy (download with `npm run fetch:pose`).
VITE_POSE_MODEL=lite
# GPU (falls back to CPU) | CPU
VITE_POSE_DELEGATE=GPU
VITE_MIN_POSE_DETECTION_CONFIDENCE=0.5
VITE_MIN_POSE_PRESENCE_CONFIDENCE=0.5
VITE_MIN_TRACKING_CONFIDENCE=0.5

# --- Dev server / asset paths ----------------------------------------------
# Set to 0.0.0.0 to expose the site on the LAN (same as `npm run dev -- --host`).
# VITE_DEV_HOST=0.0.0.0
# VITE_POSE_WASM_PATH=/mediapipe/wasm
# VITE_POSE_MODEL_DIR=/models
